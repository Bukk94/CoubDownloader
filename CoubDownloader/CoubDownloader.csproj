<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ApplicationIcon>icon.ico</ApplicationIcon>
        <Product>Coub Downloader</Product>
        <Title>Coub Downloader</Title>
        <Description>Console tool to download coubs (channels, likes, bookmarks) from coub.com</Description>
        <Authors>Bukk94</Authors>
        <Copyright>Copyright (c) Bukk94</Copyright>
        <RepositoryUrl>https://github.com/Bukk94/CoubDownloader</RepositoryUrl>
        <Version>2.0.0</Version>
        <AssemblyVersion>2.0.0</AssemblyVersion>
        <FileVersion>2.0.0</FileVersion>
        <LangVersion>default</LangVersion>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <DebugType>none</DebugType>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Configurations\Configuration.json" />
      <ContentWithTargetPath Include="Configurations\Configuration.json" TargetPath="%(Filename)%(Extension)">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </ContentWithTargetPath>
    </ItemGroup>

</Project>
